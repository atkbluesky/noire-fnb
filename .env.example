# Feedback hiện có
FEEDBACK_WEBHOOK_URL=
FEEDBACK_SECRET=

# M8.1 · PostgreSQL (Neon/Vercel Postgres/Supabase Postgres đều dùng được)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Zalo App/OA — chỉ đặt phía server, không dùng tiền tố VITE_
ZALO_APP_ID=
ZALO_APP_SECRET_KEY=
ZALO_OA_ID=
# Secret riêng của OA dùng xác thực X-ZEvent-Signature
ZALO_OA_SECRET_KEY=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=

# 32 byte dạng base64 hoặc 64 ký tự hex; dùng để mã hoá token AES-256-GCM
ZALO_TOKEN_ENCRYPTION_KEY=
# Chuỗi ngẫu nhiên >=32 ký tự; dùng HMAC user_id trước khi lưu
ZALO_USER_HASH_KEY=

# Vercel tự gửi Authorization: Bearer <CRON_SECRET> cho cron production
CRON_SECRET=

# ── M10.1 · iPOS Booking Open API (https://booking.ipos.vn/api) ──────
IPOS_API_URL=https://booking.ipos.vn/api
# Mã ứng dụng — không phải bí mật, chỉ để tra cứu trong iPOS › Ứng dụng của tôi
IPOS_APP_CODE=APP.NYSQFEFSMLCG
# Khoá ứng dụng — BÍ MẬT, chỉ dùng cho GET /v1/partner/brands/auth
IPOS_APP_KEY=
# Sinh ra sau khi admin brand bấm duyệt URL từ /brands/auth
IPOS_PARTNER_ACCESS_TOKEN=
# pos_parent của brand, nhiều brand ngăn bằng dấu phẩy
IPOS_BRAND=
# Webhook iPOS KHÔNG có chữ ký → secret đặt trong query: /api/ipos/webhook?k=<giá trị này>
IPOS_WEBHOOK_SECRET=
# Chuỗi ngẫu nhiên >=32 ký tự; HMAC số điện thoại trước khi lưu. Dùng CHUNG với bill POS
# để nối được đơn đặt bàn sang hoá đơn. Đổi khoá = mất khả năng nối lịch sử.
PHONE_HASH_KEY=

# ─── M5.1 · Ads Auto — Meta Marketing API + Google Ads API ──────────────────
# CHỈ ĐỌC. Không cấp quyền ghi cho bất kỳ khoá nào dưới đây (luật M5_1 §0.9).

# Meta: System User token của Business Manager — KHÔNG hết hạn, quyền `ads_read`.
# User token (60 ngày) chỉ dùng tạm cho `npm run probe:ads`, KHÔNG dùng cho cron.
META_ADS_SYSTEM_TOKEN=
# Nhiều tài khoản ngăn bằng phẩy. KHÔNG có tiền tố act_ — code tự thêm.
META_ADS_ACCOUNT_IDS=
# Tuỳ chọn, KHÔNG bắt buộc cho M5.1: FB_GRAPH_VERSION (trống = v23.0) ·
# FB_APP_ID + FB_APP_SECRET chỉ để `probe:ads meta` soi scope/hạn của token.
# Nếu M8.2 đã khai các key này thì dùng chung, KHÔNG khai lần hai.

# Google Ads: xin developer token ở Google Ads › Tools › API Center.
# Token mức TEST chỉ gọi được tài khoản test — cần Basic access (M5_1 §8).
GADS_DEVELOPER_TOKEN=
GADS_CLIENT_ID=
GADS_CLIENT_SECRET=
GADS_REFRESH_TOKEN=
# Customer id 10 số, KHÔNG dấu gạch. Nhiều tài khoản ngăn bằng phẩy.
GADS_CUSTOMER_IDS=
# Chỉ đặt khi truy cập qua MCC (tài khoản quản lý).
GADS_LOGIN_CUSTOMER_ID=
# Trống = code tự dò từ mới về cũ và báo version nào gọi được. Ghim một version nếu đã biết.
GADS_API_VERSION=

# Cửa sổ kéo lại mỗi lần cron chạy. 7 ngày để bắt phần Meta hiệu chỉnh attribution.
ADS_SYNC_WINDOW_DAYS=7
# Bảo vệ /api/ads/export. Trống = chỉ CRON_SECRET mở được.
ADS_EXPORT_SECRET=
